{
  "muse-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|view_file|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity_hook.py\" PreToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "muse-session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity_hook.py\" SessionStart",
        "timeout": 20
      }
    ]
  },
  "muse-completion-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity_hook.py\" Stop",
        "timeout": 480
      }
    ]
  }
}

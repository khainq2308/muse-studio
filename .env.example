ENVIRONMENT=development
POSTGRES_USER=muse
POSTGRES_PASSWORD=muse_secret_db_pass
POSTGRES_DB=musestudio
DATABASE_URL=postgresql+asyncpg://muse:muse_secret_db_pass@localhost:5432/musestudio
REDIS_URL=redis://localhost:6379/0
MEDIA_ROOT=./storage/media
SECRET_ENCRYPTION_KEY=dev-only-32-byte-secret-key-change-me!!
VITE_ORCHESTRATOR_URL=http://localhost:8000
# Required (at least 32 characters, with a real SECRET_ENCRYPTION_KEY) whenever ENVIRONMENT is not development/dev/local/test.
STUDIO_ADMIN_TOKEN=
# Dev-only Host allowlist (DNS-rebinding guard) applied when no admin token is set in development.
DEV_ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver,orchestrator-api
# Dev-only CSRF guard: with no admin token in development, state-changing requests whose
# Origin is not listed here (or that a browser marks Sec-Fetch-Site: cross-site) get 403.
DEV_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Provider base URLs must use https:// outside development unless this is set to true.
ALLOW_INSECURE_PROVIDER_HTTP=false
# Process logging to stdout (messages are secret-redacted and carry X-Request-ID).
LOG_LEVEL=INFO
# keyvalue | json
LOG_FORMAT=keyvalue
# Media/export limits (ARCH-005). Defaults shown; invariants are validated at startup and in
# apps/orchestrator/tests/test_limits_consistency.py.
# Raising MAX_UPLOAD_SIZE_BYTES also requires raising nginx client_max_body_size for
# /api/v1/assets/upload (apps/studio-web/nginx.prod.conf).
MAX_UPLOAD_SIZE_BYTES=157286400
EXPORT_FFMPEG_TIMEOUT_SECONDS=1800
EXPORT_FFPROBE_TIMEOUT_SECONDS=60
EXPORT_MAX_DURATION_SECONDS=14400
EXPORT_MAX_CLIPS=500
# Must exceed EXPORT_FFMPEG_TIMEOUT_SECONDS + 2 x EXPORT_FFPROBE_TIMEOUT_SECONDS.
EXPORT_JOB_TIMEOUT_SECONDS=2100

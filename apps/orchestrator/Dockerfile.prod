FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# muse-media is a sibling package in this monorepo and is not published to PyPI.
COPY apps/media-engine ./apps/media-engine
COPY apps/orchestrator ./apps/orchestrator

RUN pip install --no-cache-dir ./apps/media-engine \
    && pip install --no-cache-dir ./apps/orchestrator

WORKDIR /workspace/apps/orchestrator
EXPOSE 8000

CMD ["uvicorn", "muse_orchestrator.main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY apps/media-engine ./apps/media-engine
COPY apps/orchestrator ./apps/orchestrator

WORKDIR /workspace/apps/orchestrator
# Production sync installs only required dependencies; optional dev extras remain out.
RUN pip install --no-cache-dir "uv==0.10.0" \
    && uv sync --locked --project /workspace/apps/orchestrator

EXPOSE 8000

CMD ["uvicorn", "muse_orchestrator.main:app", "--host", "0.0.0.0", "--port", "8000"]

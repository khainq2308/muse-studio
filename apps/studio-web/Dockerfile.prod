FROM node:20-alpine AS builder

WORKDIR /workspace/apps/studio-web
COPY apps/studio-web/package.json ./
RUN npm install --no-audit --no-fund

# Build context is the repository root so shared TypeScript contracts are present.
COPY apps/studio-web/ ./
COPY packages/contracts/ /workspace/packages/contracts/

# "." makes browser requests same-origin; nginx proxies API calls to the orchestrator.
ARG VITE_ORCHESTRATOR_URL=.
ENV VITE_ORCHESTRATOR_URL=${VITE_ORCHESTRATOR_URL}
RUN npm run build

FROM nginx:stable-alpine
COPY apps/studio-web/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/studio-web/dist /usr/share/nginx/html
EXPOSE 80

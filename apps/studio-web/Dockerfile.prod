FROM node:20-alpine AS builder

WORKDIR /workspace/apps/studio-web
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .

# "." makes browser requests same-origin; nginx proxies API calls to the orchestrator.
ARG VITE_ORCHESTRATOR_URL=.
ENV VITE_ORCHESTRATOR_URL=${VITE_ORCHESTRATOR_URL}
RUN npm run build

FROM nginx:stable-alpine
# Run nginx as the non-root "nginx" user. Port 80 needs root, so the bundled
# config listens on 8080 instead; /var/log/nginx holds symlinks, so only the
# directory itself (not its targets) changes owner.
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/studio-web/dist /usr/share/nginx/html
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /etc/nginx/conf.d \
    && chown nginx:nginx /var/log/nginx \
    && touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid
USER nginx
EXPOSE 8080
